---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found"
  ><section class="section">
    <div class="wrap">
      <p class="eyebrow">404 / PAGE NOT FOUND</p><h1>
        Let’s get you<br />back on track.
      </h1><p class="lead muted">
        This page isn’t available. Explore the product range or contact the
        group about your requirement.
      </p><div class="row">
        <a class="btn dark" href="/products/">Browse Products →</a><a
          class="btn outline"
          href="/contact/">Contact the Group ↗</a
        >
      </div>
    </div>
  </section></Layout
>
