---
import Layout from '../layouts/Layout.astro';
import Intro from '../components/Intro.astro';
import CTA from '../components/CTA.astro';
---

<Layout title="Monir Poultry Feed Industries Limited"
  ><Intro
    eyebrow="A MONIR GROUP CONCERN"
    title="Monir Poultry Feed Industries Limited."
    description="The current Monir Group website presents this concern in connection with poultry, cattle and fish feed. Contact the group to discuss products and availability."
  />
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">BUSINESS FOCUS</p><h2>Feed for three sectors.</h2>
        </div><p class="muted">
          Product lines as listed in the current company profile.
        </p>
      </div><div class="feed-lines">
        {
          ['Poultry feed', 'Cattle feed', 'Fish feed'].map((name, i) => (
            <div class="feed-line">
              <>
                <span class="eyebrow">0{i + 1} / PRODUCT LINE</span>
                <h3>{name}</h3>
                <a
                  class="text-link"
                  href={`/contact/?product=${encodeURIComponent(name)}`}
                >
                  Discuss this requirement ↗
                </a>
              </>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <section class="section" style="background:#e9eee5">
    <div class="wrap split">
      <div>
        <p class="eyebrow">START AN INQUIRY</p><h2>
          Make your requirement specific.
        </h2><p class="muted">
          Tell the group which feed line you are interested in, the intended
          use, quantity and delivery location.
        </p>
      </div><div class="detail-panel">
        <h2>What to discuss</h2><ul>
          <li>Product type and required grade</li><li>
            Packaging and quantity
          </li><li>Current availability</li><li>
            Delivery location and timing
          </li><li>Any specifications or documentation you require</li>
        </ul><a
          class="btn dark"
          href="/contact/?product=Monir%20Poultry%20Feed%20Industries%20Limited"
          >Contact the Group ↗</a>
      </div>
    </div>
  </section><CTA /></Layout
>
