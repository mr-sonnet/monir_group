---
import Layout from '../layouts/Layout.astro';
import Intro from '../components/Intro.astro';
import CTA from '../components/CTA.astro';
import ConcernCard from '../components/ConcernCard.astro';
import businesses from '../content/businesses/companies.json';
---

<Layout
  title="Our businesses"
  description="Explore the ten concerns listed under Monir Group."
  ><Intro
    eyebrow="OUR SISTER CONCERNS"
    title="A group of distinct identities."
    description="Meet the businesses listed under Monir Group, including our trading and feed-related concerns."
  /><section class="section group-home">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">THE MONIR GROUP FAMILY</p><h2>
            Individual businesses.<br />A shared connection.
          </h2>
        </div><p class="muted">
          For company-specific inquiries, identify the concern when you contact
          the group.
        </p>
      </div><div class="concern-grid">
        {businesses.map((b) => <ConcernCard company={b} />)}
      </div><div class="section-bottom">
        <a class="btn dark" href="/contact/?type=company"
          >Contact the Group <span class="button-arrow" aria-hidden="true"
            >↗</span
          ></a>
      </div>
    </div>
  </section><CTA /></Layout
>
