---
import Layout from '../layouts/Layout.astro';
import Intro from '../components/Intro.astro';
import { company } from '../data/company';
import products from '../content/products/catalog.json';
---

<Layout
  title="Contact & Request a Quote"
  description="Discuss a product requirement with Monir Group. Find contact details, office addresses and the product inquiry form."
  ><Intro
    eyebrow="CONTACT & REQUEST A QUOTE"
    title="Let’s talk about what you need."
    description="Have a product inquiry or a question about the group? Share the details below or contact us directly."
  />
  <section class="section">
    <div class="wrap form-layout">
      <div>
        <h2>Start your inquiry.</h2><p class="muted">
          A name, one contact method, and a product or message are enough to get
          started.
        </p><div class="form-notice">
          <strong>Demo form — no inquiry will be sent.</strong><br />Use sample
          details to test this private review. For a real inquiry, call or email
          the group directly.
        </div><noscript
          ><p class="no-js">
            This demo form needs JavaScript. Please use the phone or email links
            for a real inquiry.
          </p></noscript
        ><div class="selected-product" id="selected-product" hidden></div>
        <form id="quote-form" novalidate data-endpoint={company.form.endpoint}>
          <div class="form-grid">
            <div class="field full">
              <label for="inquiryType"
                >Inquiry type <span aria-hidden="true">*</span></label
              ><select id="inquiryType" name="inquiryType" required
                ><option value="quote">Product quote</option><option
                  value="company">Group or company inquiry</option
                ><option value="other">Other</option></select>
            </div><div class="field full">
              <label for="product">Product</label><input
                id="product"
                name="product"
                list="products-list"
                maxlength="200"
                placeholder="Choose a product or type your requirement"
                aria-describedby="product-hint"
              /><datalist id="products-list"
                >{products.map((p) => <option value={p.name} />)}</datalist
              ><p class="form-hint" id="product-hint">
                Select a listed product or enter any material you need.
              </p>
            </div><div class="field">
              <label for="quantity"
                >Quantity <span class="muted">(optional)</span></label
              ><input
                id="quantity"
                name="quantity"
                maxlength="80"
                placeholder="e.g. 20"
              />
            </div><div class="field">
              <label for="unit"
                >Unit <span class="muted">(optional)</span></label
              ><select id="unit" name="unit"
                ><option value="">Choose a unit</option><option
                  >Metric tonnes</option
                ><option>Kilograms</option><option>Bags</option><option
                  >Other — specify below</option
                ></select>
            </div><div class="field full">
              <label for="location"
                >Delivery location <span class="muted">(optional)</span></label
              ><input
                id="location"
                name="location"
                maxlength="200"
                placeholder="City or delivery address"
              />
            </div><div class="field">
              <label for="company"
                >Company name <span class="muted">(optional)</span></label
              ><input
                id="company"
                name="company"
                autocomplete="organization"
                maxlength="150"
              />
            </div><div class="field">
              <label for="name"
                >Contact name <span aria-hidden="true">*</span></label
              ><input
                id="name"
                name="name"
                autocomplete="name"
                maxlength="150"
                required
              />
            </div><div class="field">
              <label for="phone">Phone</label><input
                id="phone"
                name="phone"
                type="tel"
                autocomplete="tel"
                maxlength="25"
                aria-describedby="contact-hint"
              />
            </div><div class="field">
              <label for="email">Email</label><input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                maxlength="254"
                aria-describedby="contact-hint"
              />
            </div><p class="form-hint full" id="contact-hint">
              Provide at least one: phone or email.
            </p><div class="field full">
              <label for="message">Requirements or specification</label
              ><textarea
                id="message"
                name="message"
                maxlength="4000"
                placeholder="Tell us about the material, specification or company inquiry."
                aria-describedby="message-hint"></textarea><p
                class="form-hint"
                id="message-hint"
              >
                Provide a product above or a message here. Never include payment
                information.
              </p>
            </div><div class="field full">
              <label for="reply"
                >Preferred reply method <span class="muted">(optional)</span
                ></label
              ><select id="reply" name="reply"
                ><option value="either">Either available contact method</option
                ><option value="phone">Phone</option><option value="email"
                  >Email</option
                ></select>
            </div><div class="honeypot" aria-hidden="true">
              <label for="website">Leave this field empty</label><input
                id="website"
                name="website"
                tabindex="-1"
                autocomplete="off"
              />
            </div><div class="full">
              <label class="check-label" for="consent"
                ><input
                  type="checkbox"
                  id="consent"
                  name="consent"
                  required
                /><span
                  >I have read the <a href="/privacy-policy/">privacy notice</a>
                  and agree to the described use of my information. I understand
                  this is a demo.</span
                ></label>
            </div><div class="full">
              <button class="btn dark" type="submit" id="submit-quote"
                >Test inquiry <span aria-hidden="true">↗</span></button
              ><p class="form-hint" style="margin-top:12px">
                Demo only. Your entries are not stored or emailed.
              </p>
            </div>
          </div><div
            class="form-status"
            id="form-status"
            role="status"
            tabindex="-1"
            hidden
          >
          </div>
        </form><div
          id="inquiry-review"
          class="detail-panel"
          style="margin-top:25px"
          hidden
        >
          <h3>Your demo inquiry</h3><dl id="inquiry-summary"></dl><button
            class="btn outline"
            id="edit-inquiry"
            type="button">Edit inquiry</button>
        </div>
      </div>
      <aside class="contact-aside">
        <p class="eyebrow">PREFER TO SPEAK DIRECTLY?</p><h2>
          We’re a call<br />or email away.
        </h2><div class="contact-block">
          <p class="eyebrow">CALL THE GROUP</p><a
            data-event="phone_click"
            href={company.phone.href}>{company.phone.display}</a>
        </div><div class="contact-block">
          <p class="eyebrow">EMAIL THE GROUP</p><a
            data-event="email_click"
            href={`mailto:${company.email.value}`}>{company.email.value}</a>
        </div><p class="small muted">
          Contact details are taken from the current company site. Please call
          before visiting an office.
        </p><a class="text-link" href="#locations">Find our locations ↓</a>
      </aside>
    </div>
  </section>
  <section class="section" id="locations" style="background:#e9eee5">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">OUR LOCATIONS</p><h2>Offices & warehouse.</h2>
        </div><p class="muted">
          Published addresses, subject to confirmation before launch.
        </p>
      </div><div class="location-grid">
        {
          company.locations.map((l) => (
            <div class="location">
              <>
                <p class="eyebrow">{l.name}</p>
                <h3>{l.city}</h3>
                <address>{l.address}</address>
                <a
                  class="text-link"
                  style="display:inline-block;margin-top:18px"
                  href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(l.address)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Find ${l.name} in maps (opens a new tab)`}
                >
                  Find in maps ↗
                </a>
              </>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <script>
    import { submitQuote, validateQuote, type Quote } from '../lib/quote';
    const form = document.querySelector<HTMLFormElement>('#quote-form')!;
    const product = document.querySelector<HTMLInputElement>('#product')!;
    const status = document.querySelector<HTMLElement>('#form-status')!;
    const submit = document.querySelector<HTMLButtonElement>('#submit-quote')!;
    const review = document.querySelector<HTMLElement>('#inquiry-review')!;
    const selected = document.querySelector<HTMLElement>('#selected-product')!;
    const params = new URLSearchParams(location.search);
    product.value = (params.get('product') || '').slice(0, 200);
    if (params.get('type') === 'company')
      document.querySelector<HTMLSelectElement>('#inquiryType')!.value =
        'company';
    function updateProduct() {
      selected.hidden = !product.value;
      selected.textContent = `Your product inquiry: ${product.value}`;
      const u = new URL(location.href);
      product.value
        ? u.searchParams.set('product', product.value)
        : u.searchParams.delete('product');
      history.replaceState(null, '', u);
    }
    updateProduct();
    product.addEventListener('input', updateProduct);
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submit.disabled) return;
      document.querySelectorAll('[data-error]').forEach((el) => el.remove());
      form
        .querySelectorAll('[aria-invalid]')
        .forEach((el) => el.removeAttribute('aria-invalid'));
      status.hidden = true;
      review.hidden = true;
      const data = new FormData(form);
      const text = (key: string) => String(data.get(key) || '').trim();
      const q: Quote = {
        inquiryType: text('inquiryType'),
        product: text('product'),
        quantity: text('quantity'),
        unit: text('unit'),
        location: text('location'),
        company: text('company'),
        name: text('name'),
        phone: text('phone'),
        email: text('email'),
        message: text('message'),
        reply: text('reply'),
        consent: data.get('consent') === 'on',
        website: text('website'),
      };
      const errors = validateQuote(q);
      if (Object.keys(errors).length) {
        for (const [key, value] of Object.entries(errors)) {
          const field = form.querySelector<HTMLElement>(`[name="${key}"]`)!;
          field.setAttribute('aria-invalid', 'true');
          const error = document.createElement('p');
          error.dataset.error = '';
          error.id = `${key}-error`;
          error.className = 'form-hint';
          error.style.color = '#a1271b';
          error.textContent = value;
          field.parentElement!.append(error);
          field.setAttribute(
            'aria-describedby',
            `${key === 'product' ? 'product-hint ' : key === 'phone' || key === 'email' ? 'contact-hint ' : ''}${key}-error`,
          );
        }
        status.className = 'form-status error';
        status.textContent =
          'Please check the highlighted fields. Your inquiry has not been sent.';
        status.hidden = false;
        form.querySelector<HTMLElement>('[aria-invalid]')?.focus();
        return;
      }
      submit.disabled = true;
      submit.textContent = 'Checking inquiry…';
      try {
        const result = await submitQuote(q, form.dataset.endpoint);
        status.className = 'form-status';
        status.textContent = result.message;
        status.hidden = false;
        const summary = document.querySelector('#inquiry-summary')!;
        summary.replaceChildren();
        for (const [label, value] of [
          [
            'Inquiry',
            q.inquiryType === 'quote'
              ? 'Product quote'
              : q.inquiryType === 'company'
                ? 'Group or company inquiry'
                : 'Other',
          ],
          ['Product', q.product],
          ['Quantity', [q.quantity, q.unit].filter(Boolean).join(' ')],
          ['Delivery', q.location],
          ['Company', q.company],
          ['Name', q.name],
          ['Phone', q.phone],
          ['Email', q.email],
          ['Requirements', q.message],
        ]) {
          if (value) {
            const dt = document.createElement('dt');
            dt.textContent = label;
            const dd = document.createElement('dd');
            dd.textContent = value;
            summary.append(dt, dd);
          }
        }
        review.hidden = false;
        window.dispatchEvent(
          new CustomEvent('monir:analytics', {
            detail: {
              event:
                result.mode === 'demo' ? 'rfq_demo_completed' : 'rfq_submitted',
              product: q.product,
            },
          }),
        );
        status.focus();
      } catch (error) {
        status.className = 'form-status error';
        status.textContent =
          error instanceof Error
            ? error.message
            : 'Something went wrong. Please try again.';
        status.hidden = false;
        status.focus();
      } finally {
        submit.disabled = false;
        submit.textContent = 'Test inquiry ↗';
      }
    });
    document.querySelector('#edit-inquiry')?.addEventListener('click', () => {
      review.hidden = true;
      status.hidden = true;
      product.focus();
    });
  </script></Layout
>
