---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import { company } from '../data/company';
import categories from '../data/categories.json';
import products from '../content/products/catalog.json';
import businesses from '../content/businesses/companies.json';
---

<Layout title="Ingredients for essential industries">
  <section class="hero video-hero">
    <video id="hero-video" class="hero-video" muted loop playsinline preload="none" poster="/media/monir-group/home-hero-poster.webp" aria-hidden="true" tabindex="-1" data-src="/media/monir-group/home-hero.mp4"></video>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap">
      <div class="hero-grid">
        <div>
          <p class="eyebrow">MONIR GROUP · BANGLADESH</p><h1>
            Supplying the<br />ingredients behind<br /><em
              >essential industries.</em>
          </h1><p class="lead">
            Connecting business needs with feed ingredients, grains,
            agricultural commodities and nutritional inputs. Explore our range.
            Tell us what your business needs.
          </p><div class="row">
            <a class="btn" href="/contact/"
              >Request a Quote <span aria-hidden="true">↗</span></a
            ><a class="btn outline" href="/products/"
              >Explore Products <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div><div class="hero-bottom">
        <span>Trading & feed-related businesses</span><button id="hero-video-toggle" type="button" class="video-toggle" hidden>Play background video</button><span
          >Gazipur · Dinajpur · Jamalpur</span
        ><span>Built around commercial supply</span>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">01 / OUR PRODUCT RANGE</p><h2>
            What we work with.
          </h2>
        </div><p class="muted">
          Find the materials your business needs, across four product families.
        </p>
      </div><div class="category-grid">
        {
          categories.map((c, i) => (
            <a class="category-card" href={`/products/?category=${c.id}`}>
              <>
                <span class="index">0{i + 1} / PRODUCT FAMILY</span>
                <h3>{c.name}</h3>
                <p>{c.description}</p>
                <div class="category-foot">
                  <>
                    <span>
                      {products.filter((p) => p.category === c.id).length}{' '}
                      listed products
                    </span>
                    <span class="arrow" aria-hidden="true">
                      ↗
                    </span>
                  </>
                </div>
              </>
            </a>
          ))
        }
      </div><p class="small muted" style="margin-top:20px">
        Grade, packaging and availability are discussed for each inquiry.
      </p>
    </div>
  </section>
  <section class="section dark-section" id="operations">
    <div class="wrap split">
      <div>
        <p class="eyebrow">02 / COMMERCIAL SUPPLY</p><h2>
          A clear starting point.<br />A specific conversation.
        </h2><p class="lead muted">
          We work with businesses seeking materials for feed production,
          agricultural trade and related supply needs.
        </p><a class="btn" href="/contact/"
          >Discuss your requirement <span aria-hidden="true">↗</span></a>
      </div><ol class="process">
        <li>
          <span class="num">01</span><div>
            <h3>Choose your material</h3><p>
              Explore the catalog or ask about a specific product.
            </p>
          </div>
        </li><li>
          <span class="num">02</span><div>
            <h3>Share the details</h3><p>
              Tell us the grade, quantity and delivery location you have in
              mind.
            </p>
          </div>
        </li><li>
          <span class="num">03</span><div>
            <h3>Start the conversation</h3><p>
              Discuss specifications and availability with the group.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>
  <section class="section">
    <div class="wrap split">
      <div>
        <p class="eyebrow">03 / OUR BUSINESSES</p><h2>
          One group.<br />Complementary businesses.
        </h2><p class="muted">
          Explore the companies listed under Monir Group, including trading
          businesses and a feed industry concern.
        </p><a class="text-link" href="/sister-concerns/"
          >Meet the businesses <span aria-hidden="true">↗</span></a>
      </div><div class="company-list">
        {
          businesses.slice(0, 5).map((b, i) => (
            <div class="company-row">
              <h3>{b.href ? <a href={b.href}>{b.name}</a> : b.name}</h3>
              {b.href && <span aria-hidden="true">↗</span>}
            </div>
          ))
        }<p class="small muted" style="margin-top:20px">
          View all ten concerns in the group overview.
        </p>
      </div>
    </div>
  </section>
  <section class="section" style="background:#e9eee5">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">04 / OUR FOOTPRINT</p><h2>
            Presence in Bangladesh.
          </h2>
        </div><a class="text-link" href="/contact/#locations"
          >Offices & warehouse <span aria-hidden="true">↗</span></a>
      </div><div class="location-grid">
        {
          company.locations.map((l) => (
            <div class="location">
              <>
                <p class="eyebrow">{l.name}</p>
                <h3>{l.city}</h3>
                <address>{l.address}</address>
              </>
            </div>
          ))
        }
      </div><p class="small muted" style="margin-top:25px">
        Locations as published in the current company profile. Please call
        before visiting.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="wrap split">
      <div>
        <p class="eyebrow">05 / THE PEOPLE BEHIND THE GROUP</p><h2>
          A business built<br />on relationships.
        </h2><p class="muted">
          Monir Group’s current profile dates the business to 2005. Today, it
          presents a broad portfolio for business buyers.
        </p><a class="text-link" href="/about/"
          >About Monir Group <span aria-hidden="true">↗</span></a>
      </div><div class="leaders">
        {
          company.leaders.map((l) => (
            <figure class="leader">
              <>
                <img
                  src={l.image}
                  width="450"
                  height="567"
                  alt={l.name}
                  loading="lazy"
                />
                <figcaption>
                  <>
                    <h3>{l.name}</h3>
                    <p>{l.title}</p>
                  </>
                </figcaption>
              </>
            </figure>
          ))
        }
      </div>
    </div>
  </section><CTA />
</Layout>

<script>
const video=document.querySelector<HTMLVideoElement>('#hero-video')!;
const toggle=document.querySelector<HTMLButtonElement>('#hero-video-toggle')!;
const reduced=matchMedia('(prefers-reduced-motion: reduce)');
const connection=(navigator as Navigator & {connection?:{saveData?:boolean}}).connection;
function sync(){toggle.textContent=video.paused?'Play background video':'Pause background video'}
async function play(){if(!video.getAttribute('src'))video.src=video.dataset.src!;try{await video.play()}catch{video.pause()}sync()}
toggle.hidden=false;toggle.addEventListener('click',()=>{if(video.paused)void play();else video.pause()});
video.addEventListener('play',sync);video.addEventListener('pause',sync);video.addEventListener('error',()=>{video.removeAttribute('src');video.load();toggle.hidden=true});
reduced.addEventListener('change',()=>{if(reduced.matches)video.pause()});
if(!reduced.matches&&!connection?.saveData)void play();
</script>
