---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import ConcernCard from '../components/ConcernCard.astro';
import ProductCard from '../components/ProductCard.astro';
import { company } from '../data/company';
import categories from '../data/categories.json';
import products from '../content/products/catalog.json';
import businesses from '../content/businesses/companies.json';
const categoryImages = [
  'maize',
  'wheat',
  'dicalcium-phosphate',
  'chickpea',
].map((slug) => products.find((p) => p.slug === slug)!);
const featured = [
  'maize',
  'full-fat-soybean',
  'soybean-meal',
  'fish-meal',
  'wheat',
  'dicalcium-phosphate',
].map((slug) => products.find((p) => p.slug === slug)!);
---

<Layout title="Trade, agriculture & nutrition">
  <section class="hero video-hero">
    <video
      id="hero-video"
      class="hero-video"
      muted
      loop
      playsinline
      preload="none"
      poster="/media/monir-group/home-hero-poster.webp"
      aria-hidden="true"
      tabindex="-1"
      data-src="/media/monir-group/home-hero.mp4"></video><div
      class="hero-shade"
      aria-hidden="true"
    >
    </div><div class="wrap">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">WELCOME TO MONIR GROUP</p><h1>
            The ingredients<br />behind a world<br />of <em>possibilities.</em>
          </h1><p class="lead">
            Feed ingredients. Agricultural commodities. Nutritional inputs. <br
            />Connecting your business with the materials it needs.
          </p><div class="row">
            <a class="btn" href="/products/"
              >Explore Our Products <span
                class="button-arrow"
                aria-hidden="true">↗</span
              ></a
            ><a class="hero-quote" href="/contact/"
              >Request a Quote <span aria-hidden="true">→</span></a>
          </div>
        </div><div class="hero-side">
          <span>MONIR GROUP</span><span>BANGLADESH</span>
        </div>
      </div><div class="hero-bottom">
        <span>TRADE · AGRICULTURE · NUTRITION</span><button
          id="hero-video-toggle"
          type="button"
          class="video-toggle"
          hidden>Play background video</button>
      </div>
    </div>
  </section>
  <section class="category-section" aria-label="Explore our product families">
    <div class="wrap">
      <div class="category-grid">
        {
          categories.map((c, i) => (
            <a class="category-card" href={`/products/?category=${c.id}`}>
              <>
                <div class="category-photo">
                  <img
                    src={categoryImages[i].image}
                    alt=""
                    width="280"
                    height="210"
                  />
                </div>
                <div class="category-copy">
                  <>
                    <span class="category-kicker">OUR PRODUCTS</span>
                    <h2>{c.name}</h2>
                    <span class="category-link">
                      Explore range <span aria-hidden="true">↗</span>
                    </span>
                  </>
                </div>
              </>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <section class="section about-home">
    <div class="wrap about-composition">
      <div class="about-visual">
        <img
          class="about-harvest"
          src="/media/monir-group/corn-harvest.webp"
          alt="Maize and ears of corn beside a cornfield"
          width="760"
          height="900"
          loading="lazy"
        /><div class="about-material">
          <img
            src={products.find((p) => p.slug === 'full-fat-soybean')!.image}
            alt="Soybeans"
            width="320"
            height="240"
            loading="lazy"
          />
        </div><div class="about-caption">
          <span class="caption-mark" aria-hidden="true">MG</span><span
            >Rooted in Bangladesh.<br />Connected through trade.</span>
        </div>
      </div><div class="about-copy">
        <p class="eyebrow">GET TO KNOW MONIR GROUP</p><h2>
          Many businesses.<br />One shared <span class="green-text"
            >ambition.</span>
        </h2><p class="lead">
          A Bangladesh-based group bringing together trading, agricultural
          commodities and feed-related businesses.
        </p><p class="muted">
          From maize and soybean products to minerals, grains and pulses, our
          portfolio serves a broad range of business requirements. Explore our
          concerns and find the right starting point for your next inquiry.
        </p><div class="about-points">
          <div>
            <span aria-hidden="true">✓</span><p>
              A broad range<br /><strong>of materials</strong>
            </p>
          </div><div>
            <span aria-hidden="true">✓</span><p>
              Complementary<br /><strong>group businesses</strong>
            </p>
          </div>
        </div><a class="btn dark" href="/about/"
          >Discover Our Story <span class="button-arrow" aria-hidden="true"
            >↗</span
          ></a>
      </div>
    </div>
  </section>
  <section class="section group-home">
    <div class="wrap">
      <div class="section-head centered">
        <p class="eyebrow">OUR SISTER CONCERNS</p><h2>
          Individual identities.<br /><span class="green-text"
            >A collective purpose.</span>
        </h2><p class="muted">Meet the businesses listed under Monir Group.</p>
      </div><div class="concern-grid">
        {businesses.map((b) => <ConcernCard company={b} />)}
      </div><div class="section-bottom">
        <a class="btn dark" href="/sister-concerns/"
          >Explore Our Businesses <span class="button-arrow" aria-hidden="true"
            >↗</span
          ></a>
      </div>
    </div>
  </section>
  <section class="section home-products">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">OUR PRODUCT PORTFOLIO</p><h2>
            Materials that keep<br /><span class="green-text"
              >business moving.</span>
          </h2>
        </div><div>
          <p class="muted">
            Explore ingredients and commodities for feed production,
            agricultural trade and related supply needs.
          </p><a class="text-link" href="/products/"
            >View the full catalog <span aria-hidden="true">↗</span></a>
        </div>
      </div><div class="catalog-grid featured-grid">
        {featured.map((p, i) => <ProductCard product={p} index={i} />)}
      </div>
    </div>
  </section>
  <section class="sourcing-section" id="operations">
    <img
      src="/media/monir-group/soybean-sourcing.webp"
      alt=""
      loading="lazy"
      width="1500"
      height="900"
    /><div class="sourcing-overlay"></div><div class="wrap sourcing-content">
      <div>
        <p class="eyebrow">BUILT AROUND YOUR REQUIREMENT</p><h2>
          Every material.<br />Every detail.<br /><em>Let’s talk.</em>
        </h2><a class="btn" href="/contact/"
          >Discuss Your Requirement <span
            class="button-arrow"
            aria-hidden="true">↗</span
          ></a>
      </div><ol class="process">
        <li>
          <span class="num">01</span><div>
            <h3>Choose your material</h3><p>
              Explore our range or tell us about a product you are looking for.
            </p>
          </div>
        </li><li>
          <span class="num">02</span><div>
            <h3>Share your requirements</h3><p>
              Grade, quantity, packaging and delivery location help frame the
              conversation.
            </p>
          </div>
        </li><li>
          <span class="num">03</span><div>
            <h3>Connect with the group</h3><p>
              Discuss specifications and availability with our team.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>
  <section class="section home-people">
    <div class="wrap people-composition">
      <div>
        <p class="eyebrow">THE PEOPLE BEHIND THE GROUP</p><h2>
          Leadership with<br />a shared <span class="green-text">vision.</span>
        </h2><p class="muted">
          Meet the leaders named in Monir Group’s current company profile.
        </p><a class="text-link" href="/about/#leadership"
          >More about our leadership ↗</a
        ><div class="people-note">
          <img src={company.logo} alt="" width="76" height="76" /><p>
            Trade. Agriculture. Nutrition.<br /><strong
              >Monir Group, Bangladesh.</strong>
          </p>
        </div>
      </div><div class="leaders">
        {
          company.leaders.map((l) => (
            <figure class="leader">
              <>
                <div class="portrait-frame">
                  <img
                    src={l.image}
                    width="450"
                    height="567"
                    alt={l.name}
                    loading="lazy"
                  />
                </div>
                <figcaption>
                  <>
                    <p>{l.title}</p>
                    <h3>{l.name}</h3>
                  </>
                </figcaption>
              </>
            </figure>
          ))
        }
      </div>
    </div>
  </section>
  <section class="section home-presence">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">OUR PRESENCE</p><h2>
            Here in Bangladesh.<br /><span class="green-text"
              >Ready for a conversation.</span>
          </h2>
        </div><a class="text-link" href="/contact/#locations"
          >View contact details ↗</a>
      </div><div class="presence-grid">
        {
          company.locations.map((l) => (
            <a class="presence-card" href="/contact/#locations">
              <>
                <p class="eyebrow">{l.name}</p>
                <h3>{l.city}</h3>
                <p>{l.address}</p>
                <span class="presence-arrow" aria-hidden="true">
                  ↗
                </span>
              </>
            </a>
          ))
        }
      </div>
    </div>
  </section><CTA />
</Layout>
<script>
  const video = document.querySelector<HTMLVideoElement>('#hero-video')!;
  const toggle =
    document.querySelector<HTMLButtonElement>('#hero-video-toggle')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const connection = (
    navigator as Navigator & { connection?: { saveData?: boolean } }
  ).connection;
  function sync() {
    toggle.textContent = video.paused
      ? 'Play background video'
      : 'Pause background video';
  }
  async function play() {
    if (!video.getAttribute('src')) video.src = video.dataset.src!;
    try {
      await video.play();
    } catch {
      video.pause();
    }
    sync();
  }
  toggle.hidden = false;
  toggle.addEventListener('click', () => {
    if (video.paused) void play();
    else video.pause();
  });
  video.addEventListener('play', sync);
  video.addEventListener('pause', sync);
  video.addEventListener('error', () => {
    video.removeAttribute('src');
    video.load();
    toggle.hidden = true;
  });
  reduced.addEventListener('change', () => {
    if (reduced.matches) video.pause();
  });
  if (!reduced.matches && !connection?.saveData) void play();
</script>
