---
import '../styles/global.css';
import '../styles/brand-refresh.css';
import Brand from '../components/Brand.astro';
import { company } from '../data/company';
import categories from '../data/categories.json';
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'Explore Monir Group’s feed ingredients, grains, nutritional inputs and commodities. Start a product inquiry with our team.',
} = Astro.props;
const links = [
  ['Home', '/'],
  ['About', '/about/'],
  ['Businesses', '/sister-concerns/'],
  ['Products', '/products/'],
  ['Contact', '/contact/'],
];
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><title>{title} | Monir Group</title><meta
      name="description"
      content={description}
    /><meta name="robots" content="noindex, nofollow, noarchive" /><link
      rel="canonical"
      href={canonical}
    /><meta property="og:title" content={`${title} | Monir Group`} /><meta
      property="og:description"
      content={description}
    /><meta property="og:type" content="website" /><meta
      property="og:url"
      content={canonical}
    /><meta name="theme-color" content="#202b24" /><link
      rel="icon"
      href="/media/monir-group/cropped-Monir-Group-logo-32x32.png"
    /></head
  ><body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="utility-bar">
      <div class="wrap utility-inner">
        <span class="utility-message"
          >A world of materials. A group of possibilities.</span
        ><div class="utility-contact">
          <a href={`mailto:${company.email.value}`} data-event="email_click"
            ><span aria-hidden="true">✉</span> {company.email.value}</a
          ><a href={company.phone.href} data-event="phone_click"
            ><span aria-hidden="true">☎</span> {company.phone.display}</a>
        </div>
      </div>
    </div>
    <header class="site-header">
      <div class="wrap header-inner">
        <Brand /><button
          class="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="main-nav"
          >Menu <span aria-hidden="true">☰</span></button
        ><nav class="nav" id="main-nav" aria-label="Main navigation">
          {
            links.map(([label, href]) => (
              <a
                href={href}
                aria-current={Astro.url.pathname === href ? 'page' : undefined}
              >
                {label}
              </a>
            ))
          }
        </nav><a class="btn" href="/contact/"
          >Request a Quote <span class="button-arrow" aria-hidden="true"
            >↗</span
          ></a>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="footer">
      <div class="wrap">
        <div class="footer-top">
          <Brand /><p>
            Bringing together trading and feed-related businesses<br />for the
            materials that matter.
          </p><a class="footer-back" href="#main" aria-label="Back to top">↑</a>
        </div><div class="footer-grid">
          <div class="footer-intro">
            <p class="eyebrow">LET’S START A CONVERSATION</p><a
              class="footer-phone"
              data-event="phone_click"
              href={company.phone.href}>{company.phone.display}</a
            ><a
              class="footer-email"
              data-event="email_click"
              href={`mailto:${company.email.value}`}>{company.email.value}</a
            ><p>Head office<br />South Salna, Gazipur, Bangladesh</p><a
              class="text-link"
              href="/contact/#locations">All offices & warehouse ↗</a>
          </div><div>
            <h3>Discover Monir Group</h3><div class="footer-links">
              {
                links
                  .slice(1)
                  .map(([label, href]) => <a href={href}>{label}</a>)
              }<a href="/about/#leadership">Our leadership</a>
            </div>
          </div><div>
            <h3>Our product families</h3><div class="footer-links">
              {
                categories.map((c) => (
                  <a href={`/products/?category=${c.id}`}>{c.name}</a>
                ))
              }<a href="/monir-poultry-feed-industries-limited/"
                >Poultry, cattle & fish feed</a>
            </div>
          </div>
        </div><div class="footer-bottom">
          <span>© {new Date().getFullYear()} Monir Group. Bangladesh.</span
          ><span
            >Private review · Details pending confirmation · Demo inquiries</span
          ><a href="/privacy-policy/">Privacy & data use</a>
        </div>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('#main-nav');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        nav?.classList.toggle('open', open);
      });
      document.addEventListener('keydown', (e) => {
        if (
          e.key === 'Escape' &&
          toggle?.getAttribute('aria-expanded') === 'true'
        ) {
          toggle.setAttribute('aria-expanded', 'false');
          nav?.classList.remove('open');
          toggle.focus();
        }
      });
      document
        .querySelectorAll<HTMLAnchorElement>('[data-event]')
        .forEach((a) =>
          a.addEventListener('click', () =>
            window.dispatchEvent(
              new CustomEvent('monir:analytics', {
                detail: { event: a.dataset.event },
              }),
            ),
          ),
        );
    </script></body>
</html>
