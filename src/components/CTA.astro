---
import { company } from '../data/company';
---

<section class="cta-band">
  <div class="wrap">
    <div class="cta-symbol" aria-hidden="true">↗</div><div>
      <p class="eyebrow">YOUR NEXT REQUIREMENT STARTS HERE</p><h2>
        Good business begins<br />with a conversation.
      </h2>
    </div><div class="cta-actions">
      <a class="btn dark" href="/contact/"
        >Request a Quote <span class="button-arrow" aria-hidden="true">↗</span
        ></a
      ><a href={company.phone.href}>Or call {company.phone.display}</a>
    </div>
  </div>
</section>
